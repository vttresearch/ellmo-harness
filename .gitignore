# User-supplied documents are never published from the repository
/backend/tools/internal/
/backend/tests/internal/
/backend/tools/*/*.pdf
/backend/tools/*/*.md
/backend/tools/*/*.markdown
/backend/tools/*/*.txt
!/backend/tools/*/README.md

